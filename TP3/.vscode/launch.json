            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["-e", "-t", "5", "--encodage", "utf-8", "--chemin", "C:/travail/C62_DextrazeAntoine_PoncsakVincent/TP3/textes/Test.txt"]
